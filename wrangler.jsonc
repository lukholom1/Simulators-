{
  "name": "simulators",
  "main": "_worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/dl/*"]
  },
  "r2_buckets": [
    { "binding": "FIRMWARE", "bucket_name": "zte-firmware" }
  ],
  "observability": { "enabled": true }
}
